# Copy to .env and fill in. NEVER commit .env.
# Frontend (public, restrict by HTTP referrer in Google Cloud Console):
GOOGLE_MAPS_KEY=

# Server-side only (used by Netlify Functions):
ELEVENLABS_API_KEY=
TOURAPI_KEY=

# Optional — add before final submission for the Google AI bonus category.
# If present, narration text is generated by Gemini; if absent, hand-written
# text from data/myeongdong-course.json is used. No code change needed to swap.
GEMINI_API_KEY=
